#!/usr/bin/env python3
"""
msl_migrate.py

MSL v3.14 Migration Tool

Rebuilds msl_data.py using 148_clean_nodes.txt as the single source of truth
for section, cluster, and exact artist/album naming.

Usage:
    python msl_migrate.py [-v | --verbose]
    python msl_migrate.py --dry-run -v     # Recommended while tuning matching

Features:
- Strong normalization + special case handling for difficult matches (Getz/Gilberto etc.)
- Automatic timestamped backup (unless --dry-run or --no-backup)
- --dry-run mode for safe iteration on matching logic
"""

import argparse
import os
import sys
from datetime import datetime

# Local imports
from lib.parser import parse_clean_nodes_file
from lib.matcher import match_all
from lib.schema import build_output_nodes
from lib.utils import (
    create_timestamped_backup,
    format_summary,
    get_readable_timestamp,
    load_nodes_from_file,
    save_nodes_to_file,
)


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        description="MSL v3.14 Migration Tool - Rebuild msl_data.py from clean USB listing."
    )
    parser.add_argument(
        "-v",
        "--verbose",
        action="store_true",
        help="Show detailed progress and matching information",
    )
    parser.add_argument(
        "--output",
        default="msl_data.py.new",
        help="Output filename (default: msl_data.py.new)",
    )
    parser.add_argument(
        "--no-backup",
        action="store_true",
        help="Skip creating a backup (not recommended)",
    )
    parser.add_argument(
        "--dry-run",
        action="store_true",
        help="Run matching and report only. Do not create backup or write any output file.",
    )
    return parser.parse_args()


def main() -> int:
    args = parse_args()
    verbose = args.verbose

    base_dir = os.path.dirname(os.path.abspath(__file__)) or "."
    clean_path = os.path.join(base_dir, "148_clean_nodes.txt")
    data_path = os.path.join(base_dir, "msl_data.py")
    output_path = os.path.join(base_dir, args.output)

    print(f"MSL v3.14 Migration Tool")
    print(f"Started: {get_readable_timestamp()}")
    print(f"Working directory: {base_dir}")

    # 1. Verify inputs exist
    for path, name in [(clean_path, "148_clean_nodes.txt"), (data_path, "msl_data.py")]:
        if not os.path.isfile(path):
            print(f"ERROR: Required input file not found: {name}")
            return 1

    # 2. Backup logic (skipped in dry-run)
    if args.dry_run:
        print("DRY RUN MODE - No backup will be created and no file will be written.")
    elif not args.no_backup:
        try:
            backup_path = create_timestamped_backup(data_path, verbose=verbose)
            print(f"Backup created: {os.path.basename(backup_path)}")
        except Exception as e:
            print(f"ERROR: Failed to create backup: {e}")
            return 1
    else:
        print("WARNING: Running without backup (--no-backup)")

    # 3. Parse the authoritative clean listing
    if verbose:
        print("\n[1/4] Parsing clean USB node listing (148_clean_nodes.txt)...")
    clean_nodes = parse_clean_nodes_file(clean_path)
    if verbose:
        print(f"      Loaded {len(clean_nodes)} nodes from USB listing.")

    # 4. Load existing rich data
    if verbose:
        print("\n[2/4] Loading existing rich data (msl_data.py)...")
    try:
        rich_nodes = load_nodes_from_file(data_path)
    except Exception as e:
        print(f"ERROR: Failed to load rich data: {e}")
        return 1
    if verbose:
        print(f"      Loaded {len(rich_nodes)} rich nodes.")

    # 5. Perform matching
    if verbose:
        print("\n[3/4] Matching nodes (normalized artist + album)...")
    match_results, unmatched = match_all(clean_nodes, rich_nodes, verbose=verbose)
    matched_count = len(clean_nodes) - len(unmatched)

    if verbose:
        print(f"      Matched: {matched_count} / {len(clean_nodes)}")

    # 6. Build final output nodes
    if verbose:
        print("\n[4/4] Building final node structure with correct node_id / cluster...")
    output_nodes = build_output_nodes(match_results)

    # 7. Write output file (skipped in dry-run)
    if args.dry_run:
        print("\n[DRY RUN] Skipping file write.")
    else:
        header = f"""# ============================================================
# MSL v3.14 DATA FILE  (REGENERATED)
# ============================================================
#
# Generated by msl_migrate.py on {get_readable_timestamp()}
# Source of truth for section/cluster/artist/album: 148_clean_nodes.txt
#
# Original file backed up before this run.
# ============================================================
"""

        try:
            save_nodes_to_file(output_nodes, output_path, header_comment=header)
            print(f"\nWrote: {args.output} ({len(output_nodes)} nodes)")
        except Exception as e:
            print(f"ERROR: Failed to write output file: {e}")
            return 1

    # 8. Final summary
    summary = format_summary(len(clean_nodes), matched_count, unmatched, verbose=True)
    print(summary)

    if unmatched:
        print("\nNote: Unmatched nodes were created with correct structure")
        print("      but have empty rich fields (technical_focus, tags, etc.).")
        print("      You may want to fill these in manually later.")

    if args.dry_run:
        print("\n[DRY RUN] Complete. No files were modified.")
    else:
        print(f"\nDone. Output file: {output_path}")
    return 0


if __name__ == "__main__":
    sys.exit(main())