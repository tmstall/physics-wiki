#!/usr/bin/env python3
"""
MSL Cluster Migration Script - Best attempt
"""

import shutil
import re
import argparse
from datetime import datetime
from msl_data import NODES

__GROK_VERSION__ = "2026-05-28.01"

def normalize(text):
    text = text.lower().strip()
    text = re.sub(r'[\(\)\[\]\,\.\'\"]', '', text)
    text = re.sub(r'\s+', ' ', text)
    return text

def parse_148_file(filename="148_clean_nodes.txt"):
    mapping = {}
    with open(filename, "r", encoding="utf-8") as f:
        for line in f:
            line = line.strip()
            if not line or "| NODE:" not in line:
                continue
            parts = line.split("| NODE:")
            if len(parts) != 2:
                continue
            set_part = parts[0].strip()
            node_part = parts[1].strip()

            set_match = re.search(r"Set\s+(\d+)", set_part)
            if not set_match:
                continue
            section = set_match.group(1)

            cluster_match = re.search(r"(\d+)\.(\d+)", set_part)
            cluster = cluster_match.group(2) if cluster_match else ""

            node_clean = re.sub(r"^\d+\.\d+\s*-\s*", "", node_part)

            if "little feat" in node_clean.lower() and "disc" in node_clean.lower():
                artist = "Little Feat"
                album = "Waiting for Columbus (Super Delux)"
            elif " - " in node_clean:
                artist_album = node_clean.split(" - ", 1)
                artist = artist_album[0].strip()
                album = artist_album[1].strip()
            else:
                continue

            key = (normalize(artist), normalize(album))
            mapping[key] = {"section": section, "cluster": cluster}
    return mapping

# Minimal proven overrides
OVERRIDES = {
    ("stan getz", "getz + gilberto"): {"section": "03", "cluster": "2"},
    ("stan getz", "getz/gilberto"):   {"section": "03", "cluster": "2"},
    ("bon iver", "sable, fable"): {"section": "16", "cluster": "3"},
    ("bon iver", "sable fable"):  {"section": "16", "cluster": "3"},
}

def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("-v", "--verbose", action="store_true",
                        help="Print Grok version and detailed results")
    args = parser.parse_args()

    if args.verbose:
        print(f"migrate_cluster_best.py Grok version: {__GROK_VERSION__}\n")

    timestamp = datetime.now().strftime("%Y%m%d_%H%M%S")
    backup = f"msl_data.py.backup_{timestamp}"
    shutil.copy("msl_data.py", backup)

    if args.verbose:
        print(f"✓ Backup created: {backup}")
        print("Parsing 148_clean_nodes.txt...\n")

    usb_mapping = parse_148_file("148_clean_nodes.txt")

    updated = 0
    blank = 0

    for node in NODES:
        artist = normalize(node.get("artist", ""))
        album = normalize(node.get("album", ""))
        key = (artist, album)

        if key in OVERRIDES:
            info = OVERRIDES[key]
            node["section"] = info["section"]
            node["cluster"] = info["cluster"]
            updated += 1
        elif key in usb_mapping:
            info = usb_mapping[key]
            node["section"] = info["section"]
            node["cluster"] = info["cluster"]
            updated += 1
        else:
            node.setdefault("section", "")
            node["cluster"] = ""
            blank += 1

        # v3.14 schema safety
        node.setdefault("node_id", node.get("set_id", ""))
        node.setdefault("category", node.get("set_category", ""))
        node.setdefault("subcategory", "")
        node.setdefault("technical_focus", node.get("technical_phrase", ""))
        node.setdefault("audio_description", node.get("audio_hint", ""))
        node.setdefault("bit_depth", "")
        node.setdefault("sample_rate", "")
        node.setdefault("highway_robust", False)

    with open("msl_data.py.new", "w", encoding="utf-8") as f:
        f.write("NODES = [\n")
        for node in NODES:
            f.write("    " + repr(node) + ",\n")
        f.write("]\n\n")
        f.write("def get_all_nodes():\n    return NODES\n\n")
        f.write("def get_physical_nodes():\n    return [n for n in NODES if n.get('highway_robust')]\n")

    if args.verbose:
        print("✓ Done.")
        print(f"  Nodes updated with cluster : {updated}")
        print(f"  Nodes with blank cluster   : {blank}")
        print(f"\nNew file created: msl_data.py.new")
    else:
        print(f"Updated: {updated} | Blank: {blank} | New file: msl_data.py.new")


if __name__ == "__main__":
    main()
