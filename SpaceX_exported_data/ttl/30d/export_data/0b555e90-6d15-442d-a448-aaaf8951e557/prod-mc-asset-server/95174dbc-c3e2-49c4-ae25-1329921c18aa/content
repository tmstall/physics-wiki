# v1.4 - MD to PDF Processor (raw strings for escapes, no stray tags, tested)

import re
import subprocess
import os

# Ask for filename
filename = input("Enter Markdown filename (default: new_Testing_Grok_file.md): ").strip() or "new_Testing_Grok_file.md"
if not filename.endswith('.md'): filename += '.md'

if not os.path.exists(filename):
    print("Error: File not found")
    input("Press Enter to exit...")
    exit(1)

# Read content
with open(filename, 'r', encoding='utf-8') as f:
    content = f.read()

# Unicode map (mathematical italics to ASCII)
unicode_map = {
    chr(0x1D434): 'A', chr(0x1D435): 'B', chr(0x1D436): 'C', chr(0x1D437): 'D', chr(0x1D438): 'E',
    chr(0x1D439): 'F', chr(0x1D43A): 'G', chr(0x1D43B): 'H', chr(0x1D43C): 'I', chr(0x1D43D): 'J',
    chr(0x1D43E): 'K', chr(0x1D43F): 'L', chr(0x1D440): 'M', chr(0x1D441): 'N', chr(0x1D442): 'O',
    chr(0x1D443): 'P', chr(0x1D444): 'Q', chr(0x1D445): 'R', chr(0x1D446): 'S', chr(0x1D447): 'T',
    chr(0x1D448): 'U', chr(0x1D449): 'V', chr(0x1D44A): 'W', chr(0x1D44B): 'X', chr(0x1D44C): 'Y',
    chr(0x1D44D): 'Z', chr(0x1D44E): 'a', chr(0x1D44F): 'b', chr(0x1D450): 'c', chr(0x1D451): 'd',
    chr(0x1D452): 'e', chr(0x1D453): 'f', chr(0x1D454): 'g', chr(0x1D456): 'i', chr(0x1D457): 'j',
    chr(0x1D458): 'k', chr(0x1D459): 'l', chr(0x1D45A): 'm', chr(0x1D45B): 'n', chr(0x1D45C): 'o',
    chr(0x1D45D): 'p', chr(0x1D45E): 'q', chr(0x1D45F): 'r', chr(0x1D460): 's', chr(0x1D461): 't',
    chr(0x1D462): 'u', chr(0x1D463): 'v', chr(0x1D464): 'w', chr(0x1D465): 'x', chr(0x1D466): 'y',
    chr(0x1D467): 'z'
}
for char, repl in unicode_map.items():
    content = content.replace(char, repl)

# Quotes and dashes
quotes_dashes = {
    chr(0x201C): '"', chr(0x201D): '"', chr(0x2018): "'", chr(0x2019): "'",
    chr(0x2013): '-', chr(0x2014): '-'
}
for char, repl in quotes_dashes.items():
    content = content.replace(char, repl)

# Greek to LaTeX math
greek = {
    chr(0x03B1): r'$\alpha$', chr(0x03B2): r'$\beta$', chr(0x03B3): r'$\gamma$', chr(0x03B4): r'$\delta$',
    chr(0x03B5): r'$\epsilon$', chr(0x03B8): r'$\theta$', chr(0x03BB): r'$\lambda$', chr(0x03C0): r'$\pi$',
    chr(0x03C3): r'$\sigma$', chr(0x03C4): r'$\tau$', chr(0x03C6): r'$\phi$', chr(0x03A9): r'$\Omega$',
    chr(0x0394): r'$\Delta$', chr(0x0393): r'$\Gamma$', chr(0x03A3): r'$\Sigma$'
}
for char, repl in greek.items():
    content = content.replace(char, repl)

# Fix isotopes to \ce{^{n}X}
content = re.sub(r'\^\{(\d+)\}([A-Za-z])', r'\\ce{^{\1}\2}', content)
content = re.sub(r'\$\^\{(\d+)\}\$([A-Za-z])', r'\\ce{^{\1}\2}', content)

# Wrap (p,γ) to (p,$\gamma$)
content = re.sub(r'\(p,\s*γ\s*\)', r'(p, $\gamma$)', content)

# Wrap symbols like S_p to $S_p$
content = re.sub(r'([A-Za-z]_[A-Za-z0-9])', r'$\1$', content)

# Line wrapping: 80 chars, word-safe, skip math/lines with \
lines = content.splitlines()
wrapped = []
for line in lines:
    if len(line) <= 80 or '\\' in line or '$' in line:
        wrapped.append(line)
        continue
    words = line.split()
    current = ''
    for word in words:
        test = current + ' ' + word if current else word
        if len(test) > 80:
            wrapped.append(current.strip())
            current = word
        else:
            current = test
    if current: wrapped.append(current.strip())
content = '\n'.join(wrapped)

# Save temp MD
temp_md = 'temp_' + filename
with open(temp_md, 'w', encoding='utf-8') as f:
    f.write(content)

# Call pandoc to generate PDF
base = filename.rsplit('.md', 1)[0]
pdf = base + '.pdf'
subprocess.call(['pandoc', temp_md, '-o', pdf, '--pdf-engine=xelatex', '-V', 'geometry:margin=1in', '-V', 'header-includes=\\usepackage{mhchem}\\usepackage{amsmath}', '--from', 'markdown+tex_math_dollars'])

print(f"Processed {filename} -> {pdf}")

# Feedback: Unicode/Greek/quotes mapped, isotopes to \ce, symbols/math wrapped, lines at 80 chars (skip math), Pandoc with mhchem/amsmath for PDF.