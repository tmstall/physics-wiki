#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
Generate MSL Highway Robust Subset v3.13 - Final Master Version
"""

from datetime import datetime
from docx import Document
from docx.shared import Inches, Pt, Cm
from docx.enum.text import WD_ALIGN_PARAGRAPH
from docx.oxml.ns import qn
from docx.oxml import OxmlElement
from msl_data import get_physical_nodes
from collections import defaultdict

def set_cell_shading(cell, fill_color):
    shading_elm = OxmlElement('w:shd')
    shading_elm.set(qn('w:fill'), fill_color)
    cell._tc.get_or_add_tcPr().append(shading_elm)

def get_main_set(set_id):
    return set_id.split('.')[0]

def main():
    nodes = get_physical_nodes()
    doc = Document()

    for section in doc.sections:
        section.top_margin = Cm(1.0)
        section.bottom_margin = Cm(1.0)
        section.left_margin = Cm(1.0)
        section.right_margin = Cm(1.0)

    date_str = datetime.now().strftime("%B %d, %Y")

    p = doc.add_paragraph()
    run = p.add_run(f"MSL Highway Robust Subset v3.13 — {date_str}")
    run.bold = True
    run.font.size = Pt(12)
    p.alignment = WD_ALIGN_PARAGRAPH.CENTER

    p = doc.add_paragraph()
    run = p.add_run("Master Set • Physical Nodes Only • Single Table Format")
    run.italic = True
    run.font.size = Pt(9)
    p.alignment = WD_ALIGN_PARAGRAPH.CENTER

    doc.add_paragraph()

    table = doc.add_table(rows=1, cols=3)
    table.style = 'Table Grid'

    headers = ["Artist", "Album", "Technical Verification Phrase"]
    hdr_cells = table.rows[0].cells
    for i, h in enumerate(headers):
        hdr_cells[i].text = h
        for p in hdr_cells[i].paragraphs:
            for run in p.runs:
                run.bold = True
                run.font.size = Pt(9)
        set_cell_shading(hdr_cells[i], "2F5496")

    sets = defaultdict(list)
    for node in nodes:
        main_set = get_main_set(node["set_id"])
        sets[main_set].append(node)

    for main_set in sorted(sets.keys(), key=lambda x: int(x)):
        group = sets[main_set]
        set_name = group[0]["set_category"]

        header_row = table.add_row()
        header_row.cells[0].text = f"{main_set} - {set_name}"
        header_row.cells[0].merge(header_row.cells[2])

        for p in header_row.cells[0].paragraphs:
            for run in p.runs:
                run.bold = True
                run.font.size = Pt(14)
        set_cell_shading(header_row.cells[0], "D6DCE4")

        for node in group:
            row = table.add_row()
            row.cells[0].text = node["artist"]
            row.cells[1].text = node["album"]
            row.cells[2].text = node["technical_phrase"]

            # Vertical spacing Pt(2)
            for cell in row.cells:
                for para in cell.paragraphs:
                    para.paragraph_format.space_before = Pt(2)
                    para.paragraph_format.space_after  = Pt(2)

            for cell in row.cells:
                for p in cell.paragraphs:
                    for run in p.runs:
                        run.font.size = Pt(12)

    for row in table.rows:
        row.cells[0].width = Inches(2.8)
        row.cells[1].width = Inches(3.2)
        row.cells[2].width = Inches(4.0)

    doc.save("MSL_Highway_Robust_Subset_v3.13.docx")
    print("Generated: MSL_Highway_Robust_Subset_v3.13.docx")

if __name__ == "__main__":
    main()
