
#:kivy 2.3.0
<QFTVisualizer>:
    Slider:
        min: 0.1
        max: 2.0
        value: 1.0
        size_hint: 0.8, 0.1
        pos_hint: {'center_x': 0.5, 'y': 0.05}
        on_value: root.speed_factor = self.value
    Label:
        text: f'Speed: {root.speed_factor:.2f}'
        size_hint: 0.2, 0.1
        pos_hint: {'x': 0.85, 'y': 0.05}
        color: 1, 1, 1, 1
