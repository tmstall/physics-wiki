# IMPORTANT: The extension .pdf MUST be included here
PDF_FILE = "Playlist.pdf"
PLAYLIST_NAME = "Rotel-Sonus Faber Audiophile List"

def extract_and_upload():
    # Diagnostic: Check if the file exists
    print(f"Searching for: {PDF_FILE} in {os.getcwd()}...")
    
    if not os.path.exists(PDF_FILE):
        print(f"Error: {PDF_FILE} not found.")
        print("Files currently in this folder:")
        for f in os.listdir():
            print(f" - {f}")
        return

    print(f"File found! Reading {PDF_FILE}...")
    track_queries = []

    with pdfplumber.open(PDF_FILE) as pdf:
        for page in pdf.pages:
            table = page.extract_table()
            if table:
                # Assuming standard table layout from your previous PDF
                for row in table[1:]:
                    if len(row) >= 3:
                        artist, title, album = row[1], row[2], row[3]
                        # Correcting the 'LGY' typo automatically
                        if title == "LGY": title = "I.G.Y."
                        query = f"{artist} - {title} ({album})"
                        track_queries.append(query)

    # Soundiiz API Upload
    url = "https://soundiiz.com/api/v1/playlists/import"
    headers = {
        "Authorization": f"Bearer {ACCESS_TOKEN}",
        "Cookie": COOKIE,
        "Content-Type": "application/json"
    }

    payload = {
        "title": PLAYLIST_NAME,
        "description": "High-resolution critical listening tracks.",
        "tracks": [{"query": t} for t in track_queries],
        "destination": "tidal"
    }

    response = requests.post(url, headers=headers, data=json.dumps(payload))
    if response.status_code == 200:
        print(f"Successfully created '{PLAYLIST_NAME}' in Tidal!")
    else:
        print(f"Error {response.status_code}: {response.text}")

if __name__ == "__main__":
    extract_and_upload()