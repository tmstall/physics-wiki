def clean_fs(text):
    return re.sub(r'[<>:"/\\|?*]', '', str(text)).strip()

def execute_v3_9():
    mode = "DRY RUN" if DRY_RUN else "REAL MOVE"
    print(f"--- PROTOCOL v3.9: COMPLETE 15-SET REORGANIZATION [{mode}] ---\n")
    
    verified_hits = 0
    total_staged = len(REORG_MAP)

    for src, metadata in REORG_MAP.items():
        set_header, artist, album = metadata
        
        if not os.path.exists(src):
            print(f"  [MISS] Physical bitstream path failed: {src}")
            continue

        # Top Level: Set # - Set Name
        root_dir = os.path.join(BASE_PATH, set_header)
        
        # Second Level: Artist - Album
        sub_dir_name = f"{clean_fs(artist)} - {clean_fs(album)}"
        dst = os.path.join(root_dir, sub_dir_name)

        print(f"  Mapping: {artist} -> {album}")
        print(f"    Target: {set_header}\\{sub_dir_name}")
        print(f"    CMD: mkdir \"{root_dir}\"")
        print(f"    CMD: move \"{src}\" \"{dst}\"")

        if not DRY_RUN:
            if not os.path.exists(root_dir):
                os.makedirs(root_dir, exist_ok=True)
            try:
                shutil.move(src, dst)
                verified_hits += 1
            except Exception as e:
                print(f"    [FAIL] Write Failure on disk: {e}")
        else:
            verified_hits += 1

    print("\n" + "="*60)
    print(f"  AUDIT: {verified_hits} of {total_staged} Physical Paths Resolved.")
    print("="*60)
    sys.stdout.flush()

if __name__ == "__main__":
    execute_v3_9()