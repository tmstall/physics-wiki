function markCells(cells, axis, direction) {
    for (cell in cells) {
        if (axis == 'Y') {  // Y-specific logic
            plane = getYPlane(direction);  // Y+ or Y- plane
            if (cell.intersects(plane)) {
                cell.mark = true;
                renderMarker(cell, 'dot', 'yellow');
            }
        }
        // No logic for X or Z, causing incorrect marking
    }
}

// Patched code to generalize marking across all axes
function markCells(cells, axis, direction) {
    for (cell in cells) {
        // Define plane based on axis and direction
        plane = getPlane(axis, direction);  // Generalized plane function
        if (cell.intersects(plane)) {
            cell.mark = true;
            // Consistent marker rendering for all axes
            color = getAxisColor(axis);  // e.g., Y=yellow, X=red, Z=green
            renderMarker(cell, 'dot', color);
        }
    }
}

// Helper function to compute plane for any axis
function getPlane(axis, direction) {
    position = (direction == '+') ? 1.0 : -1.0;
    if (axis == 'X') return new Plane(Vector3(position, 0, 0), position);
    if (axis == 'Y') return new Plane(Vector3(0, position, 0), position);
    if (axis == 'Z') return new Plane(Vector3(0, 0, position), position);
    if (axis == 'W') return new Plane(Vector4(0, 0, 0, position), position);  // If applicable
    throw Error('Invalid axis');
}

// Helper function for consistent coloring
function getAxisColor(axis) {
    switch (axis) {
        case 'X': return 'red';
        case 'Y': return 'yellow';
        case 'Z': return 'green';
        case 'W': return 'purple';
        default: return 'white';
    }
}

