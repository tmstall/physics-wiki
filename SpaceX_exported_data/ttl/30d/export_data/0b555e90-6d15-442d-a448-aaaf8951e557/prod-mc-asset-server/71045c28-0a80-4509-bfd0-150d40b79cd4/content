#!/usr/bin/env python3
"""
Rebuild msl_data.py from 148_clean_nodes.txt (USB ground truth)
"""

import re
import argparse
from datetime import datetime
from msl_data import NODES as OLD_NODES

__GROK_VERSION__ = "2026-05-28.04"

def normalize(text):
    text = text.lower().strip()
    text = re.sub(r'[\(\)\[\]\,\.\'\"]', '', text)
    text = re.sub(r'\s+', ' ', text)
    return text

def parse_148_file(filename="148_clean_nodes.txt"):
    nodes = []
    with open(filename, "r", encoding="utf-8") as f:
        for line in f:
            line = line.strip()
            if not line or "| NODE:" not in line:
                continue
            parts = line.split("| NODE:")
            if len(parts) != 2:
                continue
            set_part = parts[0].strip()
            node_part = parts[1].strip()

            set_match = re.search(r"Set\s+(\d+)", set_part)
            if not set_match:
                continue
            section = set_match.group(1)

            cluster_match = re.search(r"(\d+)\.(\d+)", set_part)
            cluster = cluster_match.group(2) if cluster_match else ""

            node_clean = re.sub(r"^\d+\.\d+\s*-\s*", "", node_part)

            if "little feat" in node_clean.lower() and "disc" in node_clean.lower():
                artist = "Little Feat"
                album = "Waiting for Columbus (Super Delux)"
            elif " - " in node_clean:
                artist_album = node_clean.split(" - ", 1)
                artist = artist_album[0].strip()
                album = artist_album[1].strip()
            else:
                continue

            nodes.append({
                "artist": artist,
                "album": album,
                "section": section,
                "cluster": cluster
            })
    return nodes

def build_lookup(old_nodes):
    lookup = {}
    for n in old_nodes:
        key = (normalize(n.get("artist", "")), normalize(n.get("album", "")))
        lookup[key] = n
    return lookup

def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("-v", "--verbose", action="store_true",
                        help="Show detailed progress and version")
    args = parser.parse_args()

    if args.verbose:
        print(f"rebuild_msl_data.py Grok version: {__GROK_VERSION__}\n")

    if args.verbose:
        print("Parsing 148_clean_nodes.txt (USB ground truth)...")

    usb_nodes = parse_148_file("148_clean_nodes.txt")

    if args.verbose:
        print(f"Found {len(usb_nodes)} nodes in USB data.\n")
        print("Building lookup from current msl_data.py...")

    lookup = build_lookup(OLD_NODES)

    new_nodes = []
    matched = 0
    unmatched = 0

    for usb in usb_nodes:
        key = (normalize(usb["artist"]), normalize(usb["album"]))
        old = lookup.get(key)

        if old:
            matched += 1
            new_node = {
                "node_id": f"{usb['section']}.{usb['cluster']}" if usb['cluster'] else usb['section'],
                "section": usb["section"],
                "subsection": "",
                "category": old.get("category", ""),
                "subcategory": old.get("subcategory", ""),
                "artist": old.get("artist", usb["artist"]),
                "album": old.get("album", usb["album"]),
                "year": old.get("year", ""),
                "technical_focus": old.get("technical_focus", old.get("technical_phrase", "")),
                "audio_description": old.get("audio_description", old.get("audio_hint", "")),
                "bit_depth": old.get("bit_depth", ""),
                "sample_rate": old.get("sample_rate", ""),
                "strategy": old.get("strategy", ""),
                "highway_robust": old.get("highway_robust", False),
                "tags": old.get("tags", []),
                "notes": old.get("notes", ""),
                "cluster": usb["cluster"]
            }
        else:
            unmatched += 1
            new_node = {
                "node_id": f"{usb['section']}.{usb['cluster']}" if usb['cluster'] else usb['section'],
                "section": usb["section"],
                "subsection": "",
                "category": "",
                "subcategory": "",
                "artist": usb["artist"],
                "album": usb["album"],
                "year": "",
                "technical_focus": "",
                "audio_description": "",
                "bit_depth": "",
                "sample_rate": "",
                "strategy": "",
                "highway_robust": False,
                "tags": [],
                "notes": "",
                "cluster": usb["cluster"]
            }

        new_nodes.append(new_node)

    with open("msl_data.py.new", "w", encoding="utf-8") as f:
        f.write("NODES = [\n")
        for n in new_nodes:
            f.write("    " + repr(n) + ",\n")
        f.write("]\n\n")
        f.write("def get_all_nodes():\n    return NODES\n\n")
        f.write("def get_physical_nodes():\n    return [n for n in NODES if n.get('highway_robust')]\n")

    if args.verbose:
        print("✓ Done.")
        print(f"  Matched with rich data : {matched}")
        print(f"  Unmatched (basic data) : {unmatched}")
        print(f"\nNew file created: msl_data.py.new")
    else:
        print(f"Matched: {matched} | Unmatched: {unmatched} | Output: msl_data.py.new")


if __name__ == "__main__":
    main()
