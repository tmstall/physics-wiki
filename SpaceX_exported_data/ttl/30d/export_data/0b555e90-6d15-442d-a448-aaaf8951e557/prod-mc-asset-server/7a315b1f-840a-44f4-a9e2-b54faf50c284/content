# --- Custom Button Classes for Solid Colors ---

class SolidColorButton(Button):
    def __init__(self, **kwargs):
        super().__init__(**kwargs)
        self.background_color = (0.5, 0.5, 0.5, 1)
        self.background_normal = ''
        self.background_down = ''
        self.bind(background_color=self._update_rect, pos=self._update_rect, size=self._update_rect)

    def _update_rect(self, *args):
        self.canvas.before.clear()
        with self.canvas.before:
            Color(*self.background_color)
            Rectangle(pos=self.pos, size=self.size)

class SolidColorToggleButton(ToggleButton):
    def __init__(self, **kwargs):
        super().__init__(**kwargs)
        self.background_color = (0.5, 0.5, 0.5, 1)
        self.background_normal = ''
        self.background_down = ''
        self.bind(background_color=self._update_rect, pos=self._update_rect, size=self._update_rect)
    
    def _update_rect(self, *args):
        self.canvas.before.clear()
        with self.canvas.before:
            Color(*self.background_color)
            Rectangle(pos=self.pos, size=self.size)

class PaletteButton(ToggleButton):
    border_color = ListProperty([1, 1, 1, 1])

    def __init__(self, **kwargs):
        super().__init__(**kwargs)
        self.background_normal = ''
        self.background_down = ''
        self.bind(background_color=self._update_rect, pos=self._update_rect, size=self._update_rect)
        self.bind(state=self._update_border, pos=self._update_border, size=self._update_border)

    def _update_rect(self, *args):
        self.canvas.before.clear()
        with self.canvas.before:
            Color(*self.background_color)
            Rectangle(pos=self.pos, size=self.size)

    def _update_border(self, *args):
        self.canvas.after.remove_group('selection_border')
        if self.state == 'down':
            with self.canvas.after:
                Color(*self.border_color, group='selection_border')
                Line(rectangle=(self.x + 2, self.y + 2, self.width - 4, self.height - 4), width=1.5, group='selection_border')

# --- Tesseract Logic Class (Handles math and state) ---
class Tesseract:
    def __init__(self):
        # Standard X, Y, Z, W coordinate order
        self.base_vertices_4d = np.array(
            [[s_x, s_y, s_z, s_w] for s_x in [-1, 1] for s_y in [-1, 1] for s_z in [-1, 1] for s_w in [-1, 1]]
        )
        self.edges = self._generate_edges()
        # Cell generation now matches standard order
        self.cells = [[i for i, v in enumerate(self.base_vertices_4d) if v[c] == s] for c in range(4) for s in [-1, 1]]
        self.cell_faces = [self._get_faces_for_cell(indices) for indices in self.cells]
        self.cell_centers_4d = [np.mean(self.base_vertices_4d[indices], axis=0) for indices in self.cells]
        self.angles = {'xw': 0.0, 'yw': 0.0, 'zw': 0.0, 'xy': 0.0, 'xz': 0.0, 'yz': 0.0}

    def _generate_edges(self):
        edges = []
        for i, v1 in enumerate(self.base_vertices_4d):
            for j, v2 in enumerate(self.base_vertices_4d):
                if i < j and np.sum(v1 != v2) == 1:
                    edges.append((i, j))
        return edges

    def _get_faces_for_cell(self, cell_vertex_indices):
        cell_faces = []
        cell_vertices = self.base_vertices_4d[cell_vertex_indices]
        constant_axis = next((axis for axis in range(4) if len(set(v[axis] for v in cell_vertices)) == 1), -1)
        if constant_axis == -1:
            return []  # Invalid cell, should not happen
        # Define the three varying axes for this cell
        varying_axes = [ax for ax in range(4) if ax != constant_axis]
        # Generate all six unique faces by considering all pairs of varying axes
        face_combinations = [(varying_axes[0], varying_axes[1]), (varying_axes[0], varying_axes[2]),
                           (varying_axes[0], 3), (varying_axes[1], varying_axes[2]),
                           (varying_axes[1], 3), (varying_axes[2], 3)]
        for ax1, ax2 in face_combinations:
            # Determine sign based on the cell's orientation along ax1
            sign = 1 if any(v[ax1] == 1 for v in cell_vertices) else -1
            face_v_indices = [cell_vertex_indices[k] for k, v in enumerate(cell_vertices) 
                            if (v[ax1] == sign and all(v[ax] in [-1, 1] for ax in range(4) if ax not in [ax1, ax2, constant_axis]))]
            if len(face_v_indices) == 4:  # Ensure a valid quadrilateral face
                face_key = tuple(sorted(face_v_indices))
                if face_key not in [f['vertices'] for f in cell_faces]:
                    cell_faces.append({'vertices': face_key, 'axis': ax1, 'sign': sign})
        return cell_faces  # Should yield 6 faces

    def get_projection_data(self, auto_angles):
        all_angles = self.angles.copy()
        all_angles['xy'] += auto_angles.get('xy', 0.0); all_angles['zw'] += auto_angles.get('zw', 0.0)
        INITIAL_MODEL_SCALE, INITIAL_PERSPECTIVE_DISTANCE_4D, INITIAL_PERSPECTIVE_DISTANCE_3D = 50.0, 120.0, 300.0
        scaled_vertices_4d = self.base_vertices_4d * INITIAL_MODEL_SCALE
        scaled_cell_centers_4d = [center * INITIAL_MODEL_SCALE for center in self.cell_centers_4d]
        rot_mat = self._get_rotation_matrix(all_angles)
        rotated_vertices = np.dot(scaled_vertices_4d, rot_mat.T)
        rotated_cell_centers = [np.dot(center, rot_mat.T) for center in scaled_cell_centers_4d]
        points_3d = self._project_4d_to_3d(rotated_vertices, INITIAL_PERSPECTIVE_DISTANCE_4D)
        raw_points_2d = self._project_3d_to_2d(points_3d, INITIAL_PERSPECTIVE_DISTANCE_3D)
        cell_centers_3d = self._project_4d_to_3d(rotated_cell_centers, INITIAL_PERSPECTIVE_DISTANCE_4D)
        raw_cell_centers_2d = self._project_3d_to_2d(cell_centers_3d, INITIAL_PERSPECTIVE_DISTANCE_3D)
        return raw_points_2d, raw_cell_centers_2d

    def _get_rotation_matrix(self, angles):
        rot_xy=self._rm(0,1,angles['xy']); rot_xz=self._rm(0,2,angles['xz']); rot_xw=self._rm(0,3,angles['xw'])
        rot_yz=self._rm(1,2,angles['yz']); rot_yw=self._rm(1,3,angles['yw']); rot_zw=self._rm(2,3,angles['zw'])
        return rot_zw @ rot_yw @ rot_xw @ rot_yz @ rot_xz @ rot_xy

    def _rm(self, ax1, ax2, a):
        M = np.identity(4); c, s = np.cos(a), np.sin(a)
        M[ax1, ax1] = c; M[ax1, ax2] = s; M[ax2, ax1] = -s; M[ax2, ax2] = c
        return M
        
    def _project_4d_to_3d(self, p, d): return np.array([v[:-1] * (d / (d - v[3])) if abs(d - v[3]) > 1e-6 else v[:-1] * 10000 for v in p])
    def _project_3d_to_2d(self, p, d): return [((v[0] * d / (d - v[2])), (v[1] * d / (d - v[2]))) if abs(d - v[2]) > 1e-6 else (0, 0) for v in p]

# --- Kivy Drawing Widget ---
class TesseractWidget(Widget):
    def __init__(self, app_ref, **kwargs):
        super().__init__(**kwargs)
        self.app = app_ref; self.tesseract_logic = self.app.tesseract_logic
        self.screen_margin = 30; self.last_drawn_points = []

    def on_touch_down(self, touch):
        if self.collide_point(*touch.pos):
            CLICK_RADIUS, closest_vertex_index, min_dist = 15, -1, float('inf')
            for i, p in enumerate(self.last_drawn_points):
                if p:
                    dist = math.sqrt((touch.x - p[0])**2 + (touch.y - p[1])**2)
                    if dist < min_dist: min_dist, closest_vertex_index = dist, i
            if min_dist < CLICK_RADIUS and closest_vertex_index != -1:
                tool = self.app.selected_tool
                if tool == 'ERASER':
                    if self.app.vertex_colors[closest_vertex_index]: self.app.vertex_colors[closest_vertex_index].pop()
                elif tool is not None: self.app.vertex_colors[closest_vertex_index].append(tool)
                return True
        return super().on_touch_down(touch)

    def _adjust_dot_angles(self, dot_info_list):
        if len(dot_info_list) <= 1: return dot_info_list
        MIN_SEPARATION_DEGREES = 30
        dot_info_list.sort(key=lambda d: d['angle'])
        def angle_diff(a1, a2): return 180 - abs(abs(a1 - a2) - 180)
        clusters = [];
        if not dot_info_list: return []
        current_cluster = [dot_info_list[0]]
        for i in range(1, len(dot_info_list)):
            if angle_diff(dot_info_list[i]['angle'], current_cluster[-1]['angle']) < MIN_SEPARATION_DEGREES:
                current_cluster.append(dot_info_list[i])
            else:
                clusters.append(current_cluster); current_cluster = [dot_info_list[i]]
        clusters.append(current_cluster)
        if len(clusters) > 1 and angle_diff(clusters[0][0]['angle'] + 360, clusters[-1][-1]['angle']) < MIN_SEPARATION_DEGREES:
            clusters[0].extend(clusters.pop(-1))
        final_dots = []
        for cluster in clusters:
            if len(cluster) == 1:
                final_dots.append(cluster[0]); continue
            avg_angle = math.degrees(math.atan2(sum(math.sin(math.radians(d['angle'])) for d in cluster), sum(math.cos(math.radians(d['angle'])) for d in cluster)))
            total_angle_span = (len(cluster) - 1) * MIN_SEPARATION_DEGREES
            start_angle = avg_angle - total_angle_span / 2
            for i, dot_info in enumerate(cluster):
                dot_info['angle'] = start_angle + i * MIN_SEPARATION_DEGREES; final_dots.append(dot_info)
        return final_dots

    def _draw_symbol(self, axis, sign, center_pos, base_size, color):
        Color(*color); x, y = center_pos
        if axis == 0: # X-Axis (Side)
            rx = base_size / 1.8; ry = base_size / 3.2
            p1 = (x + rx * sign, y); p2 = (x - rx * 0.5 * sign, y + ry); p3 = (x - rx * 0.5 * sign, y - ry)
            Line(points=[p1[0], p1[1], p2[0], p2[1], p3[0], p3[1], p1[0], p1[1]], width=1.2)
        elif axis == 1: # Y-Axis (Top/Bottom)
            ry = base_size / 1.8; rx = base_size / 3.2
            if sign == 1:  # Top
                p1 = (x, y + ry); p2 = (x + rx, y - ry * 0.5); p3 = (x - rx, y - ry * 0.5)
                Line(points=[p1[0], p1[1], p2[0], p2[1], p3[0], p3[1], p1[0], p1[1]], width=1.2)
            else:  # Bottom
                p1 = (x, y - ry); p2 = (x + rx, y + ry * 0.5); p3 = (x - rx, y + ry * 0.5)
                Line(points=[p1[0], p1[1], p2[0], p2[1], p3[0], p3[1], p1[0], p1[1]], width=1.2)
        elif axis == 2: # Z-Axis (Side)
            size = base_size * 1.3; r = size / 2.0
            Line(circle=(x, y, r), width=1.1)
            if sign == 1:
                Ellipse(pos=(x - r*0.4, y - r*0.4), size=(r*0.8, r*0.8))
            else:
                Line(points=[x - r*0.7, y - r*0.7, x + r*0.7, y + r*0.7], width=1.1)
                Line(points=[x - r*0.7, y + r*0.7, x + r*0.7, y - r*0.7], width=1.1)
        elif axis == 3: # W-Axis (Side)
            size = base_size * 1.3; r = size / 2.0
            Line(circle=(x, y, r), width=1.1)
            if sign == 1:
                Ellipse(pos=(x - r*0.4, y - r*0.4), size=(r*0.8, r*0.8))
            else:
                Line(points=[x - r*0.7, y - r*0.7, x + r*0.7, y + r*0.7], width=1.1)
                Line(points=[x - r*0.7, y + r*0.7, x + r*0.7, y - r*0.7], width=1.1)

    def update_canvas(self, auto_angles):
        self.canvas.clear()
        raw_points_2d, raw_cell_centers_2d = self.tesseract_logic.get_projection_data(auto_angles)
        final_points, final_cell_centers, scale = self._fit_points_to_view(raw_points_2d, raw_cell_centers_2d)
        self.last_drawn_points = final_points
        with self.canvas:
            for cell_index, color in self.app.face_markings.items():
                faces = self.tesseract_logic.cell_faces[cell_index]
                for face_info in faces:
                    face_vertex_indices = face_info['vertices']
                    face_points_2d = [final_points[i] for i in face_vertex_indices]
                    if any(p is None for p in face_points_2d) or len(face_points_2d) != 4: continue
                    r, g, b, _ = color; Color(r, g, b, 0.2)
                    # Render each face as two triangles for proper shading
                    vertices = [coord for p in face_points_2d for coord in (p[0], p[1], 0, 0)]
                    Mesh(vertices=vertices, indices=[0, 1, 2, 0, 2, 3], mode='triangles')
                    # Calculate centroid for symbol placement
                    center_x = sum(p[0] for p in face_points_2d) / 4
                    center_y = sum(p[1] for p in face_points_2d) / 4
                    self._draw_symbol(face_info['axis'], face_info['sign'], (center_x, center_y), 12, color)
            Color(0.78, 0.78, 1, 0.8)
            for edge in self.tesseract_logic.edges:
                p1, p2 = final_points[edge[0]], final_points[edge[1]]
                if p1 and p2: Line(points=[p1[0], p1[1], p2[0], p2[1]], width=1.2)
            for i in range(16):
                p_center = final_points[i]
                if not p_center: continue
                Color(1, 1, 1, 1); Ellipse(pos=(p_center[0] - 4, p_center[1] - 4), size=(8, 8))
                if self.app.vertex_colors[i]:
                    dot_info_list = []
                    for c in self.app.vertex_colors[i]:
                        color_rgba, source_cell_index = c; angle = 0
                        if source_cell_index is not None and final_cell_centers[source_cell_index]:
                            p_cell_center = final_cell_centers[source_cell_index]
                            angle = math.degrees(math.atan2(p_center[1] - p_cell_center[1], p_center[0] - p_cell_center[0]))
                        dot_info_list.append({'color': color_rgba, 'angle': angle})
                    adjusted_dots = self._adjust_dot_angles(dot_info_list)
                    for dot in adjusted_dots:
                        Color(*dot['color']); angle_rad = math.radians(dot['angle'])
                        draw_offset_x = 6.0 * math.cos(angle_rad); draw_offset_y = 6.0 * math.sin(angle_rad)
                        dot_size = 9
                        Ellipse(pos=(p_center[0] + draw_offset_x - (dot_size/2), p_center[1] + draw_offset_y - (dot_size/2)), size=(dot_size, dot_size))

    def _fit_points_to_view(self, raw_points, raw_cell_centers):
        valid_points = [p for p in raw_points if p and not (math.isnan(p[0]) or math.isinf(p[0]))]
        if not valid_points: return ([], [], 1.0)
        min_x = min(p[0] for p in valid_points); max_x = max(p[0] for p in valid_points)
        min_y = min(p[1] for p in valid_points); max_y = max(p[1] for p in valid_points)
        raw_w = max_x - min_x; raw_h = max_y - min_y; raw_cx = (min_x + max_x) / 2; raw_cy = (min_y + max_y) / 2
        drawable_w = max(1, self.width - 2 * self.screen_margin); drawable_h = max(1, self.height - 2 * self.screen_margin)
        scale_x = float('inf') if raw_w < 1e-6 else drawable_w / raw_w; scale_y = float('inf') if raw_h < 1e-6 else drawable_h / raw_h
        scale = 1.0 if (scale_x == float('inf') and scale_y == float('inf')) else min(scale_x, scale_y)
        scale = np.clip(scale, 0.1, 5.0); target_cx = self.center_x; target_cy = self.center_y
        final_points = [((p[0] - raw_cx) * scale + target_cx, (p[1] - raw_cy) * scale + target_cy) if p and not math.isnan(p[0]) else None for p in raw_points]
        final_centers = [((p[0] - raw_cx) * scale + target_cx, (p[1] - raw_cy) * scale + target_cy) if p and not math.isnan(p[0]) else None for p in raw_cell_centers]
        return final_points, final_centers, scale

# --- Main Kivy App Class ---
class TesseractApp(App):
    NUDGE_INCREMENT = 0.005

    def build(self):
        self.tesseract_logic = Tesseract()
        self.auto_angles = {'xy': 0.0, 'zw': 0.0}; self.auto_rotate_speeds = {'xy': 0.003, 'zw': 0.002}
        self.is_auto_rotating = True; self.last_manual_rotation_info = {'axis_name': None, 'original_sign': 0}
        self.held_keys = set(); self.speed_multiplier = 1.0
        self.vertex_mark_buttons = []; self.face_mark_toggles = []
        self.vertex_colors = {i: [] for i in range(16)}; self.vertex_cell_color_map = {}; self.face_markings = {}
        self.selected_tool = None
        
        self.palette_colors_hex = ['#e41a1c', '#377eb8', '#4daf4a', '#984ea3', '#ff7f00', '#ffff33', '#a65628', '#f781bf']
        self.cell_names = ["X-", "X+", "Y-", "Y+", "Z-", "Z+", "W-", "W+"]
        self.palette_colors_rgba = [get_color_from_hex(c) for c in self.palette_colors_hex]
        
        root = BoxLayout(orientation='vertical', spacing=5, padding=5)
        self.tesseract_widget = TesseractWidget(self); root.add_widget(self.tesseract_widget)
        top_ui_panel = BoxLayout(orientation='vertical', size_hint_y=None, height=160)
        
        tools_panel = BoxLayout(orientation='horizontal', size_hint_y=None, height=50, spacing=10)
        palette_layout = GridLayout(rows=2, cols=4, spacing=2)
        for c in self.palette_colors_rgba:
            btn = PaletteButton(group='color_palette', background_color=c); btn.tool_info = (c, None)
            btn.bind(on_press=self.on_tool_select); palette_layout.add_widget(btn)
        eraser_button = PaletteButton(text='Erase', group='color_palette', size_hint_x=None, width=50, background_color=(.5, .5, .5, 1)); eraser_button.tool_info = 'ERASER'
        eraser_button.bind(on_press=self.on_tool_select)
        tools_panel.add_widget(Label(text="Tools:", size_hint_x=None, width=50)); tools_panel.add_widget(palette_layout)
        tools_panel.add_widget(eraser_button)
        tools_panel.add_widget(Button(text="Clear All", on_press=self.clear_all_markings, size_hint_x=None, width=100))
        
        marking_panel_container = BoxLayout(orientation='horizontal', spacing=10)
        vertex_mark_panel = self._create_marking_panel("Mark Cell Vertices", self.on_vertex_mark_toggle, self.vertex_mark_buttons, is_toggle=True)
        face_mark_panel = self._create_marking_panel("Mark Cell Faces", self.on_face_mark_toggle, self.face_mark_toggles, is_toggle=True)
        marking_panel_container.add_widget(vertex_mark_panel); marking_panel_container.add_widget(face_mark_panel)
        
        rotation_panel = BoxLayout(orientation='horizontal', size_hint_y=None, height=40, spacing=10)
        self.toggle_button = Button(text='Auto-Rotate:ON', size_hint_x=None, width=180); self.toggle_button.bind(on_press=self.toggle_auto_rotate)
        self.speed_slider = Slider(min=0.1, max=1.5, value=1.0); self.speed_slider.bind(value=self.on_slider_value_change)
        self.speed_value_label = Label(text='1.00x', size_hint_x=None, width=100)
        rotation_panel.add_widget(self.toggle_button); rotation_panel.add_widget(Label(text='Speed:', size_hint_x=None, width=50)); rotation_panel.add_widget(self.speed_slider); rotation_panel.add_widget(self.speed_value_label)
        
        top_ui_panel.add_widget(tools_panel); top_ui_panel.add_widget(marking_panel_container); top_ui_panel.add_widget(rotation_panel)
        root.add_widget(top_ui_panel)
        
        Window.bind(on_key_down=self._on_key_down, on_key_up=self._on_key_up); Clock.schedule_interval(self.update, 1.0/60.0)
        return root

    def _create_marking_panel(self, label_text, on_press_handler, button_list, is_toggle=False):
        panel = BoxLayout(orientation='vertical', spacing=2)
        panel.add_widget(Label(text=label_text, size_hint_y=None, height=20, halign='center'))
        layout = GridLayout(rows=2, cols=4, spacing=2)
        for i in range(8):
            ButtonClass = SolidColorToggleButton if is_toggle else SolidColorButton
            btn = ButtonClass(text=self.cell_names[i]); btn.cell_index = i
            btn.bind(on_press=on_press_handler); button_list.append(btn); layout.add_widget(btn)
        panel.add_widget(layout)
        return panel

    def update(self, dt):
        BASE_MANUAL_SPEED = 0.02
        if not self.held_keys.intersection({'lshift', 'rshift'}):
            for k in self.held_keys:
                a = self.key_map.get(k)
                if a:
                    rotation_amount = a['sign'] * BASE_MANUAL_SPEED * self.speed_multiplier
                    self.tesseract_logic.angles[a['axis']] += rotation_amount
                    self.last_manual_rotation_info = {'axis_name': a['axis'], 'original_sign': a['sign']}
        if self.is_auto_rotating:
            self.auto_angles['xy'] += self.auto_rotate_speeds['xy'] * self.speed_multiplier * 60 * dt
            self.auto_angles['zw'] += self.auto_rotate_speeds['zw'] * self.speed_multiplier * 60 * dt
        self.tesseract_widget.update_canvas(self.auto_angles)

    def on_face_mark_toggle(self, instance):
        cell_idx = instance.cell_index
        if instance.state == 'down':
            tool = self.selected_tool
            if tool and isinstance(tool, tuple):
                color_to_apply, _ = tool
                self.face_markings[cell_idx] = color_to_apply
                instance.background_color = color_to_apply
            else: instance.state = 'normal'
        else:
            if cell_idx in self.face_markings: del self.face_markings[cell_idx]
            instance.background_color = (0.5, 0.5, 0.5, 1)

    def on_vertex_mark_toggle(self, instance):
        cell_idx = instance.cell_index
        if instance.state == 'down':
            tool = self.selected_tool
            if tool and isinstance(tool, tuple):
                color_to_apply, _ = tool
                self.vertex_cell_color_map[cell_idx] = color_to_apply
                for vertex_index in self.tesseract_logic.cells[cell_idx]:
                    self.vertex_colors[vertex_index].append((color_to_apply, cell_idx))
                self.update_vertex_button_colors()
            else: instance.state = 'normal'
        else: # state is 'normal'
            self._unmark_vertex_cell(cell_idx)

    def on_tool_select(self, instance):
        if instance.state == 'down': self.selected_tool = getattr(instance, 'tool_info', None)
    
    def clear_all_markings(self, instance):
        self.vertex_colors = {i: [] for i in range(16)}; self.vertex_cell_color_map = {}
        self.face_markings = {}; 
        self.update_vertex_button_colors()
        for toggle in self.face_mark_toggles:
            toggle.state = 'normal'; toggle.background_color = (0.5, 0.5, 0.5, 1)
        for toggle in self.vertex_mark_buttons:
             toggle.state = 'normal'; toggle.background_color = (0.5, 0.5, 0.5, 1)

    def update_vertex_button_colors(self):
        default_color = (0.5, 0.5, 0.5, 1)
        for i, btn in enumerate(self.vertex_mark_buttons):
            btn.background_color = self.vertex_cell_color_map.get(i, default_color)

    def _unmark_vertex_cell(self, cell_to_remove_idx):
        if cell_to_remove_idx in self.vertex_cell_color_map:
            color_to_remove = self.vertex_cell_color_map.pop(cell_to_remove_idx)
            for vertex_index in self.tesseract_logic.cells[cell_to_remove_idx]:
                self.vertex_colors[vertex_index] = [c for c in self.vertex_colors[vertex_index] if c[0] != color_to_remove]
            self.update_vertex_button_colors()

    def toggle_auto_rotate(self, i):
        self.is_auto_rotating = not self.is_auto_rotating; i.text = 'Auto-Rotate:ON' if self.is_auto_rotating else 'Auto-Rotate:OFF'

    def on_slider_value_change(self, instance, value):
        self.speed_multiplier = value; self.speed_value_label.text = f'{value:.2f}x'

    def _on_key_down(self, window, key, scancode, codepoint, modifiers):
        key_name = kivy.core.window.Keyboard.keycode_to_string(None, key); self.held_keys.add(key_name)
        action = self.key_map.get(key_name)
        if 'shift' in modifiers and action:
            self.tesseract_logic.angles[action['axis']] += action['sign'] * self.NUDGE_INCREMENT
            self.last_manual_rotation_info = {'axis_name': action['axis'], 'original_sign': action['sign']}
        elif key_name in ('pageup', 'pagedown') and not self.is_auto_rotating and self.last_manual_rotation_info['axis_name']:
            axis, original_sign = self.last_manual_rotation_info['axis_name'], self.last_manual_rotation_info['original_sign']
            if original_sign != 0:
                direction = 1 if key_name == 'pageup' else -1
                self.tesseract_logic.angles[axis] += original_sign * self.NUDGE_INCREMENT * direction
        if key_name == 'escape': self.stop()

    def _on_key_up(self, window, key, *args):
        self.held_keys.discard(kivy.core.window.Keyboard.keycode_to_string(None, key))

    key_map = {'q': {'axis': 'xw', 'sign': 1}, 'w': {'axis': 'xw', 'sign': -1}, 'a': {'axis': 'yw', 'sign': 1}, 's': {'axis': 'yw', 'sign': -1}, 'z': {'axis': 'zw', 'sign': 1}, 'x': {'axis': 'zw', 'sign': -1}, 'e': {'axis': 'xy', 'sign': 1}, 'r': {'axis': 'xy', 'sign': -1}, 'd': {'axis': 'xz', 'sign': 1}, 'f': {'axis': 'xz', 'sign': -1}, 'c': {'axis': 'yz', 'sign': 1}, 'v': {'axis': 'yz', 'sign': -1}}

