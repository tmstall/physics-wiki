#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
MSL v3.13 Master Generator
Generates all final v3.13 140-node Master Gold Set files
"""

import subprocess
import shutil
import time
from pathlib import Path
from datetime import datetime

def main():
    print("=" * 65)
    print("MSL v3.13 — 140 Node Master Gold Set Generator")
    print(f"Started: {datetime.now().strftime('%B %d, %Y %H:%M')}")
    print("=" * 65)

    scripts = [
        "generate_gold_list.py",
        "generate_highway.py",
        "generate_alphabetic.py",
        "generate_audio_hints.py"
    ]

    start_time = time.time()
    success_count = 0

    for i, script in enumerate(scripts, 1):
        print(f"\n[{i}/{len(scripts)}] Running {script} ...")
        try:
            result = subprocess.run(
                ["python", script],
                capture_output=True,
                text=True,
                check=True
            )
            print(f"   ✓ Success")
            success_count += 1
        except subprocess.CalledProcessError as e:
            print(f"   ✗ Failed: {e}")

    elapsed = time.time() - start_time

    print("\n" + "=" * 65)
    print("Generation Complete")
    print(f"Successful: {success_count}/{len(scripts)}")
    print(f"Time taken: {elapsed:.1f} seconds")
    print("=" * 65)

    print("\nFinal v3.13 Master Gold Set Files:")
    for f in sorted(Path(".").glob("MSL_*_v3.13.docx")):
        print(f"  • {f.name}")

    print("\nDocumentation Files (part of v3.13 Master Set):")
    print("  • README.md")
    print("  • README.txt")

    print("\nAll files are now part of the locked v3.13 Master Gold Set.")

if __name__ == "__main__":
    main()
