#!/usr/bin/env python3
"""
MSL v3.14 Golden List Generator

Generates the main logical master document (Golden List) as a .docx file.

Usage:
    python generate_gold_list.py
    python generate_gold_list.py -v
    python generate_gold_list.py --verbose
"""

import argparse
import ast
import re
import sys
from datetime import datetime
from pathlib import Path
from docx import Document
from docx.shared import Inches, Pt, Cm
from docx.enum.text import WD_ALIGN_PARAGRAPH
from docx.enum.style import WD_STYLE_TYPE
from docx.oxml.ns import qn
from docx.oxml import OxmlElement


def set_cell_shading(cell, color):
    """Set cell background color (hex string without #, e.g. '2F5496')."""
    shading_elm = OxmlElement('w:shd')
    shading_elm.set(qn('w:fill'), color)
    cell._tc.get_or_add_tcPr().append(shading_elm)


def prevent_row_split(row):
    """Prevent this table row from breaking across pages (keeps node together)."""
    tr = row._tr
    trPr = tr.get_or_add_trPr()
    cantSplit = OxmlElement('w:cantSplit')
    trPr.append(cantSplit)

# ============================================================
# CONFIG
# ============================================================

SCRIPT_VERSION = "3.14.0"
# DATA_FILE = Path(__file__).parent.parent / "msl_data.py"
# Try to find msl_data.py intelligently

from pathlib import Path

script_path = Path(__file__).resolve()

# Try to find msl_data.py in common locations
candidates = [
    script_path.parent.parent / "msl_data.py",   # Normal layout: script is in scripts/
    script_path.parent / "msl_data.py",          # Script is in same folder as msl_data.py
    Path.cwd() / "msl_data.py",                  # Running from the folder that contains msl_data.py
]

DATA_FILE = None
for candidate in candidates:
    if candidate.exists():
        DATA_FILE = candidate
        break

if DATA_FILE is None:
    raise FileNotFoundError(
        "Could not find msl_data.py.\n"
        "Please make sure msl_data.py is either:\n"
        "  - In the same folder as this script, or\n"
        "  - One level above the 'scripts' folder."
    )

OUTPUT_DIR = Path(__file__).parent.parent / "output"
OUTPUT_FILE = OUTPUT_DIR / "MSL_Golden_List_v3.14.docx"


def get_grok_version():
    return f"Grok 4.3 beta (MSL Golden List Generator v{SCRIPT_VERSION})"


def add_page_number(paragraph):
    """Add page number field to a paragraph."""
    run = paragraph.add_run()
    fldChar1 = OxmlElement('w:fldChar')
    fldChar1.set(qn('w:fldCharType'), 'begin')
    
    instrText = OxmlElement('w:instrText')
    instrText.set(qn('xml:space'), 'preserve')
    instrText.text = "PAGE"
    
    fldChar2 = OxmlElement('w:fldChar')
    fldChar2.set(qn('w:fldCharType'), 'end')
    
    run._r.append(fldChar1)
    run._r.append(instrText)
    run._r.append(fldChar2)


def create_header_footer(doc):
    """Add header and footer with page numbers."""
    section = doc.sections[0]
    
    # Header
    header = section.header
    header_para = header.paragraphs[0]
    header_para.text = "MSL Golden List v3.14  •  Master Set List"
    header_para.alignment = WD_ALIGN_PARAGRAPH.CENTER
    run = header_para.runs[0]
    run.font.size = Pt(9)
    run.font.italic = True
    
    # Footer with page number
    footer = section.footer
    footer_para = footer.paragraphs[0]
    footer_para.alignment = WD_ALIGN_PARAGRAPH.CENTER
    
    run1 = footer_para.add_run("Page ")
    run1.font.size = Pt(9)
    
    add_page_number(footer_para)
    
    run2 = footer_para.add_run("  |  MSL v3.14 Gold Standard")
    run2.font.size = Pt(9)


def load_nodes():
    with open(DATA_FILE, 'r', encoding='utf-8') as f: content = f.read()
    match = re.search(r'NODES\s*=\s*(\[.*?\])\s*(?:\n\ndef|\n#|\Z)', content, re.DOTALL)
    if not match:
        raise RuntimeError("Could not locate NODES list")
    
    return ast.literal_eval(match.group(1))


def group_by_section(nodes):
    """Group nodes by section, preserving order."""
    sections = {}
    for node in nodes:
        sec = node.get('section', '00')
        if sec not in sections:
            sections[sec] = []
        sections[sec].append(node)
    return sections


def get_section_title(section_num, nodes_in_section):
    """Generate a nice section title."""
    if not nodes_in_section:
        return f"{section_num} - Unknown"
    
    first = nodes_in_section[0]
    category = first.get('category', 'Unknown')
    
    # Map common section numbers to friendly titles
    titles = {
        '01': '01 - Foundational Benchmarks (Physical Media/Analog)',
        '02': '02 - Rock Classics (Audiophile Reference)',
        '03': '03 - Acoustic & Blues (Harmonic Friction)',
        '04': '04 - Vocal Intimacy (Mid-Range Transparency)',
        '05': '05 - Lyrical Beauty (Emotional Texture)',
        '06': '06 - String Transients (Leading Edge Attack)',
        '07': '07 - Kinetic Action (Transient Speed)',
        '08': '08 - Geometric Phase (Holographic Soundstage)',
        '09': '09 - Lyrical Power & Resonance (Sustain & Decay)',
        '10': '10 - Resonance Metal (High-Frequency Mechanical Detail)',
        '11': '11 - Resonance Felt (Internal Mechanical Damping)',
        '12': '12 - Modern Audiophile (Contemporary Production)',
        '13': '13 - Synthetic Topology (Square Wave & Oscillator Stress)',
        '14': '14 - Cinematic & Orchestral (Dynamic Scale)',
        '15': '15 - Pipe Organ & Sub-Bass (Low-Frequency Extension)',
        '16': '16 - Human-Machine Interface (Complex Vocal Synthesis)',
        '17': '17 - Macro-Dynamic Impulse (Current Evaluation)',
        '18': '18 - FINAL SYSTEM STRESS TEST (Peak Thermal Saturation)',
        '19': '19 - The Legacy Expansion (Macro-Dynamic Impact)',
    }
    
    return titles.get(section_num, f"{section_num} - {category}")


def generate_gold_list(verbose=False):
    if verbose:
        print(get_grok_version())
        print(f"Data file: {DATA_FILE}")
        print(f"Output:    {OUTPUT_FILE}\n")
    
    print("Loading nodes...")
    nodes = load_nodes()
    print(f"Loaded {len(nodes)} nodes")

    # Sort: by section, then by cluster number, then alphabetically by artist/album
    # This ensures cluster 1 nodes appear before cluster 2, etc. within each set
    def gold_sort_key(n):
        section = n.get('section', '00')
        cluster_str = n.get('cluster', '') or '0'
        try:
            cluster_num = int(cluster_str)
        except ValueError:
            cluster_num = 999
        artist = n.get('artist', '').lower()
        album = n.get('album', '').lower()
        return (section, cluster_num, artist, album)

    nodes.sort(key=gold_sort_key)
    print("Sorted by section → cluster → artist/album")

    sections = group_by_section(nodes)
    print(f"Found {len(sections)} sections")
    
    # Create document
    doc = Document()
    
    # Set comfortable margins
    for section in doc.sections:
        section.top_margin = Cm(1.8)
        section.bottom_margin = Cm(1.8)
        section.left_margin = Cm(2.0)
        section.right_margin = Cm(2.0)
    
    # Title
    title = doc.add_heading('MSL Golden List v3.14', 0)
    title.alignment = WD_ALIGN_PARAGRAPH.CENTER
    
    # Subtitle
    subtitle = doc.add_paragraph()
    subtitle.alignment = WD_ALIGN_PARAGRAPH.CENTER
    run = subtitle.add_run('Master Set List — 153 Nodes — Gold Standard')
    run.font.size = Pt(11)
    run.font.italic = True
    
    # Generated timestamp
    ts = doc.add_paragraph()
    ts.alignment = WD_ALIGN_PARAGRAPH.CENTER
    run = ts.add_run(f'Generated: {datetime.now().strftime("%Y-%m-%d %H:%M")}')
    run.font.size = Pt(9)
    
    doc.add_paragraph()
    
    # ============================================================
    # SINGLE MASTER TABLE - v3.13 style with blue headers
    # ============================================================
    
    main_table = doc.add_table(rows=1, cols=4)
    main_table.style = 'Table Grid'
    
    # Column widths
    col_widths = [Cm(1.8), Cm(4.3), Cm(5.5), Cm(6.9)]  # Cluster widened for full word
    for row in main_table.rows:
        for idx, cell in enumerate(row.cells):
            cell.width = col_widths[idx]
    
    # === TOP COLUMN HEADER (Dark blue like v3.13) ===
    hdr_cells = main_table.rows[0].cells
    hdr_cells[0].text = 'Cluster'
    hdr_cells[1].text = 'Artist'
    hdr_cells[2].text = 'Album'
    hdr_cells[3].text = 'Technical Verification Phrase'
    
    for cell in hdr_cells:
        set_cell_shading(cell, '2F5496')  # Dark blue
        for paragraph in cell.paragraphs:
            paragraph.alignment = WD_ALIGN_PARAGRAPH.CENTER
            for run in paragraph.runs:
                run.bold = True
                run.font.size = Pt(11)
    
    # Add content with section headers starting in Column 1
    for sec_num in sorted(sections.keys()):
        section_nodes = sections[sec_num]
        section_title = get_section_title(sec_num, section_nodes)
        
        # === SECTION HEADER ROW (merged, light blue, name starts in Col 1) ===
        sec_row = main_table.add_row().cells
        
        # Merge all four cells so the section name appears on one clean line
        sec_row[0].merge(sec_row[1])
        sec_row[0].merge(sec_row[2])
        sec_row[0].merge(sec_row[3])
        
        sec_row[0].text = section_title   # Full section title starting in column 1
        
        set_cell_shading(sec_row[0], 'BDD7EE')  # Light blue background
        for paragraph in sec_row[0].paragraphs:
            for run in paragraph.runs:
                run.bold = True
                run.font.size = Pt(11)
        
        # Data rows - prevent splitting across pages
        for node in section_nodes:
            row_cells = main_table.add_row().cells
            
            cluster = node.get('cluster', '')
            row_cells[0].text = cluster if cluster else ''
            row_cells[1].text = node.get('artist', '')
            row_cells[2].text = node.get('album', '')
            row_cells[3].text = node.get('technical_focus', '')
            
            # Keep this entire node row together on one page
            prevent_row_split(main_table.rows[-1])
            
            for i, cell in enumerate(row_cells):
                for paragraph in cell.paragraphs:
                    paragraph.paragraph_format.space_before = Pt(2)
                    paragraph.paragraph_format.space_after = Pt(2)
                    for run in paragraph.runs:
                        run.font.size = Pt(12)
                        if i == 0:
                            paragraph.alignment = WD_ALIGN_PARAGRAPH.CENTER
    
    # Add header/footer with page numbers
    create_header_footer(doc)
    
    # Ensure output dir exists
    OUTPUT_DIR.mkdir(parents=True, exist_ok=True)
    
    # Save
    doc.save(OUTPUT_FILE)
    print(f"\n✓ Generated: {OUTPUT_FILE}")
    print(f"  Total nodes: {len(nodes)}")
    print(f"  Sections:    {len(sections)}")


def main():
    parser = argparse.ArgumentParser(description="MSL v3.14 Golden List Generator")
    parser.add_argument('-v', '--verbose', action='store_true',
                        help='Show version and detailed progress')
    args = parser.parse_args()
    
    try:
        generate_gold_list(verbose=args.verbose)
    except Exception as e:
        print(f"ERROR: {e}")
        sys.exit(1)


if __name__ == '__main__':
    main()
