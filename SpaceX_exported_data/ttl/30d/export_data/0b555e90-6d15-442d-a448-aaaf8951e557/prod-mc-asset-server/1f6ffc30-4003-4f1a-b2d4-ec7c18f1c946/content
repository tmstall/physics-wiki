#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
Generate MSL Alphabetic List v3.13 - Final Master Version
"""

from datetime import datetime
from docx import Document
from docx.shared import Inches, Pt, Cm
from docx.enum.text import WD_ALIGN_PARAGRAPH
from docx.oxml.ns import qn
from docx.oxml import OxmlElement
from msl_data import get_all_nodes

def set_cell_shading(cell, fill_color):
    shading_elm = OxmlElement('w:shd')
    shading_elm.set(qn('w:fill'), fill_color)
    cell._tc.get_or_add_tcPr().append(shading_elm)

def main():
    nodes = get_all_nodes()
    doc = Document()

    for section in doc.sections:
        section.top_margin = Cm(1.0)
        section.bottom_margin = Cm(1.0)
        section.left_margin = Cm(1.0)
        section.right_margin = Cm(1.0)

    date_str = datetime.now().strftime("%B %d, %Y")

    p = doc.add_paragraph()
    run = p.add_run(f"MSL Alphabetic List v3.13 — 140 Nodes — {date_str}")
    run.bold = True
    run.font.size = Pt(12)
    p.alignment = WD_ALIGN_PARAGRAPH.CENTER

    p = doc.add_paragraph()
    run = p.add_run("Master Set • Clean Artist Names with [set_id]")
    run.italic = True
    run.font.size = Pt(9)
    p.alignment = WD_ALIGN_PARAGRAPH.CENTER

    doc.add_paragraph()

    sorted_nodes = sorted(nodes, key=lambda x: x["artist"].lower())

    table = doc.add_table(rows=1, cols=2)
    table.style = 'Table Grid'

    headers = ["Artist - Album", "Bit / Sample"]
    hdr_cells = table.rows[0].cells
    for i, h in enumerate(headers):
        hdr_cells[i].text = h
        for p in hdr_cells[i].paragraphs:
            for run in p.runs:
                run.bold = True
                run.font.size = Pt(10)
            if i == 1:  # Center the "Bit / Sample" header
                p.alignment = WD_ALIGN_PARAGRAPH.CENTER
        set_cell_shading(hdr_cells[i], "2F5496")

    for node in sorted_nodes:
        row = table.add_row()
        artist_album = f"{node['artist']} - {node['album']} [{node['set_id']}]"
        row.cells[0].text = artist_album
        row.cells[1].text = node["bit_sample"]

        # Vertical spacing Pt(2)
        for cell in row.cells:
            for para in cell.paragraphs:
                para.paragraph_format.space_before = Pt(2)
                para.paragraph_format.space_after  = Pt(2)

        # Center the "Bit / Sample" column (data rows)
        for para in row.cells[1].paragraphs:
            para.alignment = WD_ALIGN_PARAGRAPH.CENTER

        for cell in row.cells:
            for p in cell.paragraphs:
                for run in p.runs:
                    run.font.size = Pt(12)

    for row in table.rows:
        row.cells[0].width = Inches(5.0)
        row.cells[1].width = Inches(2.7)

    doc.save("MSL_Alphabetic_List_v3.13.docx")
    print("Generated: MSL_Alphabetic_List_v3.13.docx")

if __name__ == "__main__":
    main()
