# === Markdown to PDF v77 - ULTIMATE FIXES ===
# Fixes: Full Unicode, isotopes in \ce{}, symbol defs in math, no overflows, mhchem package

$ErrorActionPreference = "Stop"
Trap {
    Write-Host "`n`nUNHANDLED ERROR!" -ForegroundColor Red
    Write-Host $_.Exception.Message -ForegroundColor Red
    Read-Host "`nPress Enter to exit..." | Out-Null
    Exit 1
}

$ScriptDir = Split-Path -Parent $MyInvocation.MyCommand.Definition
Set-Location $ScriptDir

Clear-Host
Write-Host "==================================================="
Write-Host "   Markdown to PDF Converter v77 - ULTIMATE FIXED"
Write-Host "   (Full Unicode, isotopes, symbols in math, no overflows)"
Write-Host "==================================================="
Write-Host ""

# 1. Ask for file
$Default = "new_Testing_Grok_file.md"
Write-Host "Enter filename (or press Enter for default):" -ForegroundColor Yellow
Write-Host "   Default -> $Default" -ForegroundColor Gray
$InputName = Read-Host "   File"

if ([string]::IsNullOrWhiteSpace($InputName)) { $InputName = $Default }
$InputFile = $InputName.Trim(' "''')

if (-not (Test-Path $InputFile)) {
    Write-Host "`nERROR: File not found -> $InputFile" -ForegroundColor Red
    Read-Host "Press Enter to exit..." | Out-Null
    Exit 1
}

# 2. Output same name
$BaseName = [IO.Path]::GetFileNameWithoutExtension($InputFile)
$OutputFile = "$BaseName.pdf"
$TempFile = "temp_$BaseName.md"
$LogFile = "log_$BaseName.txt"

"=== Log $(Get-Date) ===" | Out-File $LogFile -Encoding UTF8
"Input  : $InputFile"  | Add-Content $LogFile
"Output : $OutputFile" | Add-Content $LogFile

Write-Host "`nFound    -> $InputFile" -ForegroundColor Green
Write-Host "Creating -> $OutputFile`n"

# 3. Read file
$content = Get-Content -Path $InputFile -Raw -Encoding UTF8

# Remove optional code fence
if ($content -match '(?s)^```markdown\s*\r?\n') {
    $content = $content -replace '(?s)^```markdown\s*\r?\n(.*?)\r?\n```\s*$', '$1'
}

# 4. Protect display math $$...$$
$DisplayMath = @{}
$cnt = 0
$content = [regex]::Replace($content, '(?s)\$\$(.*?)\$\$', {
    $token = "__DISPLAY_$cnt__"
    $DisplayMath[$token] = $Matches[0]
    $cnt++
    $token
})

# 5. Protect inline math $...$
$InlineMath = @{}
$cnt = 0
$content = [regex]::Replace($content, '(?<!\\)\$([^\$]+?)\$', {
    $token = "__INLINE_$cnt__"
    $InlineMath[$token] = $Matches[0]
    $cnt++
    $token
})

# 6. Comprehensive Unicode cleanup (full mathematical italic A-Z/a-z)
$mathUnicode = @{
    0x1D434 = 'A'; 0x1D435 = 'B'; 0x1D436 = 'C'; 0x1D437 = 'D'; 0x1D438 = 'E';
    0x1D439 = 'F'; 0x1D43A = 'G'; 0x1D43B = 'H'; 0x1D43C = 'I'; 0x1D43D = 'J';
    0x1D43E = 'K'; 0x1D43F = 'L'; 0x1D440 = 'M'; 0x1D441 = 'N'; 0x1D442 = 'O';
    0x1D443 = 'P'; 0x1D444 = 'Q'; 0x1D445 = 'R'; 0x1D446 = 'S'; 0x1D447 = 'T';
    0x1D448 = 'U'; 0x1D449 = 'V'; 0x1D44A = 'W'; 0x1D44B = 'X'; 0x1D44C = 'Y';
    0x1D44D = 'Z'; 0x1D44E = 'a'; 0x1D44F = 'b'; 0x1D450 = 'c'; 0x1D451 = 'd';
    0x1D452 = 'e'; 0x1D453 = 'f'; 0x1D454 = 'g'; 0x1D456 = 'i'; 0x1D457 = 'j';
    0x1D458 = 'k'; 0x1D459 = 'l'; 0x1D45A = 'm'; 0x1D45B = 'n'; 0x1D45C = 'o';
    0x1D45D = 'p'; 0x1D45E = 'q'; 0x1D45F = 'r'; 0x1D460 = 's'; 0x1D461 = 't';
    0x1D462 = 'u'; 0x1D463 = 'v'; 0x1D464 = 'w'; 0x1D465 = 'x'; 0x1D466 = 'y';
    0x1D467 = 'z'
}
foreach ($code in $mathUnicode.Keys) {
    $content = $content.Replace([char]::ConvertFromUtf32($code), $mathUnicode[$code])
}

# Quotes and dashes
$repl = @(
    @{c=0x201C;t='"'} , @{c=0x201D;t='"'} , @{c=0x2018;t="'"} , @{c=0x2019;t="'"},
    @{c=0x2013;t='-'} , @{c=0x2014;t='-'}
)
foreach ($r in $repl) {
    $content = $content.Replace([char]::ConvertFromUtf32($r.c), $r.t)
}

# Greek letters (expanded)
$greek = @{
    0x03B1='$\alpha$'; 0x03B2='$\beta$'; 0x03B3='$\gamma$'; 0x03B4='$\delta$';
    0x03B5='$\epsilon$';0x03B8='$\theta$'; 0x03BB='$\lambda$'; 0x03C0='$\pi$';
    0x03C3='$\sigma$'; 0x03C4='$\tau$'; 0x03C6='$\phi$'; 0x03A9='$\Omega$';
    0x0394='$\Delta$'; 0x0393='$\Gamma$'; 0x03A3='$\Sigma$'; 0x03BC='$\mu$'
}
foreach ($code in $greek.Keys) {
    $content = $content.Replace([char]::ConvertFromUtf32($code), $greek[$code])
}

# 7. Convert isotopes to \ce{^{n}X} (both ^{n}X and $^{n}$X)
$content = [regex]::Replace($content, '\^\{(\d+)\}([A-Za-z])', '\\ce{^{$1}$2}')
$content = [regex]::Replace($content, '\$\^\{(\d+)\}\$([A-Za-z])', '\\ce{^{$1}$2}')

# 8. Wrap common math symbols and (p,\gamma) patterns
$inlineSymbols = @{
    "\\gamma" = "$\gamma$"; "\\cdot" = "$\cdot$"; "\\langle" = "$\langle$"; "\\rangle" = "$\rangle$";
    "\\sigma" = "$\sigma$"; "\\alpha" = "$\alpha$"; "\\beta" = "$\beta$"; "\\delta" = "$\delta$";
    "\\theta" = "$\theta$"; "\\lambda" = "$\lambda$"; "\\pi" = "$\pi$"; "\\mu" = "$\mu$"
}
foreach ($key in $inlineSymbols.Keys) {
    $content = $content.Replace($key, $inlineSymbols[$key])
}

# Wrap (p,\gamma) to (p,$\gamma$)
$content = [regex]::Replace($content, '\(p,\s*\\gamma\s*\)', '(p, $\gamma$)')

# 9. Wrap symbol definitions like S_p : to $S_p$:
$content = [regex]::Replace($content, '([A-Za-z]_[A-Za-z0-9])\s*:\s*', '$$$1$$: ')

# 10. Smart paragraph wrapping (70 chars for safety, word-safe, skip headings/math)
Write-Host "Wrapping long paragraphs..." -ForegroundColor Yellow
$lines = $content -split "`r?`n"
$wrapped = @()

foreach ($line in $lines) {
    # Skip headings, empty lines, protected math
    if ($line -match '^#{1,6}\s' -or $line.Trim() -eq "" -or $line -match '__DISPLAY_') {
        $wrapped += $line
        continue
    }

    if ($line.Length -le 70) {
        $wrapped += $line
        continue
    }

    $words = $line -split '\s+'
    $current = ""

    foreach ($word in $words) {
        $test = if ($current) { "$current $word" } else { $word }
        if ($test.Length -gt 70) {
            $wrapped += $current.TrimEnd()
            $current = $word
        } else {
            $current = $test
        }
    }
    if ($current) { $wrapped += $current.TrimEnd() }
}

$content = $wrapped -join "`n"

# 11. Restore inline math first, then display
foreach ($token in $InlineMath.Keys) {
    $content = $content.Replace($token, $InlineMath[$token])
}
foreach ($token in $DisplayMath.Keys) {
    $content = $content.Replace($token, $DisplayMath[$token])
}

# 12. Save temp file
Set-Content -Path $TempFile -Value $content -Encoding UTF8

# 13. Run Pandoc with math support, mhchem, and margins
Write-Host "Running Pandoc (20-60 seconds)..." -ForegroundColor Cyan

& pandoc $TempFile -o $OutputFile --pdf-engine=xelatex -V colorlinks=true -V linkcolor=blue -V geometry:margin=1in -V 'header-includes=\usepackage{mhchem}' -V fontsize=11pt --from markdown+tex_math_dollars 2>&1 | Tee-Object -FilePath $LogFile -Append

# Result
if (Test-Path $OutputFile) {
    $kb = [math]::Round((Get-Item $OutputFile).Length / 1KB, 1)
    Write-Host "`nSUCCESS! PDF created" -ForegroundColor Green
    Write-Host "-> $OutputFile ($kb KB)" -ForegroundColor Cyan
} else {
    Write-Host "`nFAILED - PDF not created" -ForegroundColor Red
}

Remove-Item $TempFile -ErrorAction SilentlyContinue

Write-Host "`nLog saved: $LogFile"
Write-Host "`n==================================================="
Write-Host "   All done! Press Enter to close."
Read-Host | Out-Null